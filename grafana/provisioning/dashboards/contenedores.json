{
  "title": "Monitoreo de Contenedores",
  "timezone": "browser",
  "panels": [
    {
      "type": "timeseries",
      "title": "Uso de CPU por Contenedor",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-DS"
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "container_cpu_usage_percent",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Uso de Memoria por Contenedor",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-DS"
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "container_memory_usage_bytes",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Red Recibida (Bytes Totales)",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-DS"
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total[5m])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Red Enviada (Bytes Totales)",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-DS"
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "expr": "rate(container_network_transmit_bytes_total[5m])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
