{
  "title": "Monitoreo de Contenedores",
  "timezone": "browser",
  "panels": [
    {
      "type": "timeseries",
      "title": "Uso de CPU por Contenedor",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-DS"
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total{id=~\".*docker.*\"}[5m]) * 100",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Uso de Memoria por Contenedor",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-DS"
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "container_memory_usage_bytes{id=~\".*docker.*\"}",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Red Recibida (Bytes/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-DS"
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "rate(container_network_receive_bytes_total{id=\"/\"}[5m])",
          "legendFormat": "{{interface}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Red Enviada (Bytes/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-DS"
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "expr": "rate(container_network_transmit_bytes_total{id=\"/\"}[5m])",
          "legendFormat": "{{interface}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
